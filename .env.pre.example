# 预发环境：复制为 .env.pre，并替换数据库连接及填写独立的 SECRET_KEY。
DATABASE_URL=postgresql+asyncpg://user:password@pre-db/console_pre
SECRET_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_READ_TIMEOUT_SECONDS=60
CHAT_STREAM_TIMEOUT_SECONDS=300
DEBUG=false
RELOAD=false
PORT=8000
WORKERS=1
COOKIE_SECURE=true
# 通过反向代理部署时，填写实际代理 IP / 网段。
FORWARDED_ALLOW_IPS=127.0.0.1
# 填写实际预发前端 Origin；JSON 数组格式，只有协议、域名和可选端口。
AUTH_ALLOWED_ORIGINS=["https://pre-console.example.com"]
