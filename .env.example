# 开发环境：复制为 .env.dev，也兼容原有 .env。
DATABASE_URL=postgresql+asyncpg://user:password@localhost/console_dev
DEBUG=true
PORT=8000
COOKIE_SECURE=false
CORS_ALLOW_ORIGIN="http://localhost:5173;http://localhost:8000"

# 使用 python -c "import secrets; print(secrets.token_urlsafe(64))" 生成环境独立密钥
SECRET_KEY=

# AI 对话（仅后端读取；未配置时其他功能仍可使用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_READ_TIMEOUT_SECONDS=60
CHAT_STREAM_TIMEOUT_SECONDS=300
